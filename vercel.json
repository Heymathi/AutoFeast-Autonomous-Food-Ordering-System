{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-execute-schedules",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "src/data/**"
    }
  }
}
