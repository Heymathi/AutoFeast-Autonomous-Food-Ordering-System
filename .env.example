# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Email via Gmail SMTP (App Password, not account password)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop

# Alternatively: generic SMTP settings
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_user
# SMTP_PASS=your_password

# Base URLs
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000

# Client Vite API Base URL (optional for Vercel deployment)
VITE_API_BASE_URL=https://autonomous-food-ordering-system.vercel.app

# JWT signing secret — use a long random string in production
JWT_SECRET=autofeast_super_secure_jwt_secret_key_2026_production

# SMS Provider Configuration (Optional: Twilio / Fast2SMS / MSG91)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FAST2SMS_API_KEY=
